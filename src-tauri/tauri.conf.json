{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI2Assistant",
  "version": "0.1.0",
  "identifier": "com.ai2assistant.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI助手 - 个人事项智能整理小助手",
        "url": "index.html",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "decorations": true
      },
      {
        "label": "hud",
        "title": "AI2Assistant HUD",
        "url": "index.html",
        "width": 360,
        "height": 76,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
